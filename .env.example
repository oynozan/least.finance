# Privy credentials, from https://dashboard.privy.io → your app → Settings.
# In that dashboard, also enable Solana wallets (Solana login) for the app; Solana sign-in fails without it.
# Copy this file to .env.local and fill in the values.
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional: an app client ID, for per-environment settings.
NEXT_PUBLIC_PRIVY_CLIENT_ID=
# The deposit server (server/). Unset, the app uses http://localhost:4500.
NEXT_PUBLIC_API_URL=
