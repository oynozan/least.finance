{
    "name": "least-finance",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "test:e2e": "playwright test",
        "test:logic": "LOGIC_ONLY=1 playwright test --project=logic",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "pm2:start": "npm run build && npx pm2 start ecosystem.config.cjs",
        "pm2:web": "npm run build && npx pm2 start ecosystem.config.cjs --only least-web",
        "pm2:restart": "npm run build && npx pm2 reload ecosystem.config.cjs",
        "pm2:stop": "npx pm2 stop ecosystem.config.cjs",
        "pm2:logs": "npx pm2 logs",
        "pm2:status": "npx pm2 status"
    },
    "dependencies": {
        "@number-flow/react": "0.6.2",
        "@privy-io/react-auth": "^3.48.0",
        "@solana-program/memo": "^0.10.0",
        "@solana-program/system": "^0.10.0",
        "@solana-program/token": "^0.9.0",
        "@solana/kit": "^5.5.1",
        "motion": "^14.0.0",
        "next": "16.4.3",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "sharp": "0.35.5",
        "socket.io-client": "4.8.3",
        "viem": "^2.56.5"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^9",
        "eslint-config-next": "16.4.3",
        "prettier": "3.9.9",
        "socket.io": "4.8.3",
        "tailwindcss": "^4.3.3",
        "typescript": "^5"
    }
}
