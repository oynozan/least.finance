# Copy to server/.env and fill in. Never commit the real file.

# --- HTTP ---------------------------------------------------------------
PORT=4500
# Optional; unset listens on every interface, IPv4 and IPv6.
HOST=
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Web app origins allowed to call the API and open sockets, comma-separated.
# In production, the site's origin: https://least.finance
CORS_ORIGINS=http://localhost:3000
# Reverse proxies in front of the server (0 when it's exposed directly). Rate limits key on the client IP this resolves.
# In production it must equal that count, or every user shares one IP for the per-IP limits on the public /markets routes.
TRUST_PROXY=0
# Socket connections a minute from one IP (users behind one NAT share it).
SOCKET_HANDSHAKES_PER_MINUTE=120

# --- MongoDB ------------------------------------------------------------
# Must be a replica set (deposits are credited in transactions). `docker compose up -d` in server/ starts one here.
MONGODB_URI=mongodb://localhost:27018/?replicaSet=rs0
MONGODB_DB=TradeEverything

# --- Privy --------------------------------------------------------------
# Dashboard → your app → Settings → Basics. The app ID is the web app's NEXT_PUBLIC_PRIVY_APP_ID.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Recommended: the verification key (Settings → Basics), PEM with \n for newlines. Tokens are then checked
# with no request to Privy; without it, the server fetches (and caches) Privy's key set.
PRIVY_VERIFICATION_KEY=

# --- Arc Mainnet --------------------------------------------------------
# Optional, comma-separated; defaults to Arc's public RPCs (rpc.mainnet.arc.io, Blockdaemon, dRPC).
ARC_RPC_URLS=

# --- Deposits -----------------------------------------------------------
# BIP-39 phrase every account's deposit address derives from. Whoever holds it holds the deposits:
# generate it once (npm run mnemonic), keep it in a secret manager, and back it up. Changing it
# orphans every existing deposit address.
DEPOSIT_MNEMONIC=
# Transfers below this many USDC aren't credited.
DEPOSIT_MIN_USDC=0.01
# Withdrawals below this many USDC are refused.
WITHDRAW_MIN_USDC=0.01
# Chain scan cadence in ms, and blocks per log query.
DEPOSIT_POLL_MS=1000
DEPOSIT_SCAN_RANGE=500
# Blocks to wait past a deposit's block. Arc's finality is instant, so 0.
DEPOSIT_CONFIRMATIONS=0
# Blocks the chain scan stays behind the head, so a lagging node behind a load-balanced RPC can't
# make it skip any. Reported deposits don't wait for this.
DEPOSIT_SCAN_LAG_BLOCKS=3
# Optional: block the very first scan starts at (otherwise the oldest account's, or the chain head).
DEPOSIT_START_BLOCK=
# How long a reported deposit may take to appear on chain.
DEPOSIT_RECEIPT_TIMEOUT_MS=30000

# --- Deposits from other chains ----------------------------------------
# Optional, comma-separated, tried in order; default to public RPCs (publicnode for Ethereum,
# bnbchain.org's dataseed for BNB Chain). Paid endpoints hold up better under load.
ETHEREUM_RPC_URLS=
BNB_RPC_URLS=
# Optional, comma-separated, tried in order; default to Solana's public RPC, which rate-limits.
SOLANA_RPC_URLS=
# Optional, comma-separated, tried in order; the RPCs swaps read wallets' coins from on the other EVM networks
# (Ethereum, BNB Chain and Arc use the lists above). They default to public RPCs, which rate-limit.
ARBITRUM_RPC_URLS=
BASE_RPC_URLS=
OPTIMISM_RPC_URLS=
POLYGON_RPC_URLS=
AVALANCHE_RPC_URLS=
# Optional: your Relay API key, sent with Relay requests.
RELAY_API_KEY=
# Optional: your Across API key, sent as a Bearer token with every Across request.
ACROSS_API_KEY=
# Optional: your Across integrator ID, sent with Across quotes.
ACROSS_INTEGRATOR_ID=
# How often a bridge order's status is checked, in ms (100 or more).
ORDER_POLL_MS=1500

# --- Prediction markets ------------------------------------------------
# Polymarket's public APIs, read for the market list and prices; these are the defaults.
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
# How often the top events are re-read, in ms (1000 or more).
MARKETS_SYNC_MS=60000

# --- Prediction trading -------------------------------------------------
# on sends real orders to Polymarket from the pool's wallet; off keeps predictions simulated.
PREDICTIONS_TRADING=off
# Owner key of the pool's deposit wallet (0x + 64 hex). Run `node --env-file=.env scripts/polymarket-setup.ts` once, then fund the wallet it prints with pUSD.
POLYMARKET_POOL_KEY=
# Builder API credentials (polymarket.com → Settings → Builders); they authorize the gasless relayer.
POLYMARKET_BUILDER_API_KEY=
POLYMARKET_BUILDER_API_SECRET=
POLYMARKET_BUILDER_API_PASSPHRASE=
# Optional: your builder code (0x + 64 hex), attributing the pool's orders to your profile.
POLYMARKET_BUILDER_CODE=
# Optional: pins the deposit wallet's address instead of deriving it from the pool key.
POLYMARKET_DEPOSIT_WALLET=
# Polygon RPC for approvals; the public default is rate limited, so use your own in production.
POLYGON_RPC_URL=https://polygon.drpc.org
# Polymarket's relayer and data API; these are the defaults.
POLYMARKET_RELAYER_URL=https://relayer-v2.polymarket.com
POLYMARKET_DATA_URL=https://data-api.polymarket.com
# The pUSD the pool should hold; warnings fire under 25% and over 200% of it, and orders are capped by what's free.
POLYMARKET_FLOAT_USD=100
# How often unsettled prediction orders are checked, in ms (100 or more).
PREDICTIONS_POLL_MS=2000
# Polymarket's Collateral Onramp wraps USDC.e (bridged), not native USDC, into pUSD.
# Host the server outside Polymarket's restricted regions, and call Polymarket directly, with no proxies.

# --- Swaps (LI.FI) -------------------------------------------------------
# The fee collection wallet registered with LI.FI: EVM at m/44'/60'/0'/0/0, Solana at m/44'/501'/0'/0'. Keep it out of the deposit mnemonic.
LIFI_FEE_MNEMONIC=
# LI.FI Partner Portal API key; it stays on the server, which quotes every swap.
LIFI_API_KEY=
# LI.FI's API; this is the default.
LIFI_URL=https://li.quest
# Names the app to LI.FI: letters, digits, dots, dashes and underscores, up to 23 characters.
LIFI_INTEGRATOR=least-finance
# The share of each swap kept as our fee, from 0 up to but not including 0.1.
LIFI_FEE=0
# How often the swap coins' prices are re-read from LI.FI, in ms (10000 or more).
SWAPS_CATALOG_SYNC_MS=300000
