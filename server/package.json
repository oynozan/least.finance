{
    "name": "least-finance-server",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24.12"
    },
    "scripts": {
        "dev": "node --watch --env-file-if-exists=.env src/index.ts",
        "start": "node --env-file-if-exists=.env src/index.ts",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:mainnet": "vitest run --config vitest.mainnet.config.ts",
        "mnemonic": "node scripts/mnemonic.ts",
        "db:up": "docker compose -p trade-everything up -d --wait",
        "db:down": "docker compose -p trade-everything down",
        "test:e2e-backend": "node test/e2e/serve.ts"
    },
    "dependencies": {
        "@privy-io/node": "0.35.0",
        "@scure/bip39": "1.6.0",
        "cors": "2.8.6",
        "express": "5.2.1",
        "express-rate-limit": "8.7.0",
        "helmet": "8.3.0",
        "jose": "6.2.12",
        "mongodb": "7.6.0",
        "pino": "10.3.1",
        "pino-http": "11.0.0",
        "rate-limiter-flexible": "11.2.1",
        "socket.io": "4.8.3",
        "viem": "2.56.9",
        "zod": "4.6.5"
    },
    "devDependencies": {
        "@types/cors": "2.8.19",
        "@types/express": "5.0.6",
        "@types/node": "26.6.2",
        "@types/supertest": "7.2.1",
        "mongodb-memory-server": "11.3.0",
        "pino-pretty": "13.1.3",
        "socket.io-client": "4.8.3",
        "supertest": "7.3.0",
        "typescript": "6.0.3",
        "vitest": "4.1.11"
    }
}
